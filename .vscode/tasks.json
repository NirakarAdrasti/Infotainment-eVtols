{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Root Python Dependencies",
      "type": "shell",
      "command": "pip",
      "args": [
        "install",
        "-r",
        "requirements.txt"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Main Python Script",
      "type": "shell",
      "command": "python",
      "args": [
        "main.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Object Detection",
      "type": "shell",
      "command": "python",
      "args": [
        "object_detection.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
