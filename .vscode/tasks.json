        "jay_tiwari/backend",
        "&&",
        "pip",
        "install",
        "-r",
        "requirements.txt",
        "&&",
        "uvicorn",
        "main:app",
        "--reload"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
